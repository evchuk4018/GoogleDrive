NODE_ENV=development
NEXT_PUBLIC_DRIVE_BASE_PATH=
POSTGRES_DB=googledrive
POSTGRES_USER=googledrive
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://googledrive:change-me@postgres:5432/googledrive
DRIVE_API_TOKEN=replace-with-a-long-random-token
DRIVE_STORAGE_ROOT=/srv/storage/googledrive/files
DRIVE_MAX_UPLOAD_BYTES=1073741824
DRIVE_MAX_MCP_WRITE_BYTES=8388608
DRIVE_MCP_MAX_READ_BYTES=262144
DRIVE_SESSION_TTL_SECONDS=28800
DRIVE_DB_POOL_MAX=10
